# Application
APP_NAME=FinSentinel AI
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=finsentinel
POSTGRES_USER=finsentinel
POSTGRES_PASSWORD=finsentinel_dev
DATABASE_URL=postgresql+psycopg://finsentinel:finsentinel_dev@postgres:5432/finsentinel

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=banking_policies

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=finsentinel_dev

# Redpanda / Kafka
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TRANSACTION_TOPIC=banking.transactions
KAFKA_CASE_TOPIC=banking.cases

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=banking-documents

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=finsentinel
KEYCLOAK_CLIENT_ID=finsentinel-web
KEYCLOAK_CLIENT_SECRET=replace-me
JWT_AUDIENCE=finsentinel-api

# Observability
OTEL_SERVICE_NAME=finsentinel-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
PROMETHEUS_PORT=9464

# AI providers (later phases)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM_PROVIDER=mock
