  "panels": [
    {
      "id": 1,
      "title": "Workflow Rate",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "finsentinel-prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(rate(finsentinel_workflow_executions_total[5m]))",
          "refId": "A"
        }
      ]
    },
