{
  "realm": "finsentinel",
  "enabled": true,
  "displayName": "FinSentinel AI",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "fraud_analyst"
      },
      {
        "name": "aml_investigator"
      },
      {
        "name": "credit_analyst"
      },
      {
        "name": "compliance_officer"
      },
      {
        "name": "executive"
      },
      {
        "name": "platform_admin"
      },
      {
        "name": "auditor"
      }
    ]
  },
  "clients": [
    {
      "clientId": "finsentinel-web",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "finsentinel-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "finsentinel-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "lightweight.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "finsentinel-api",
      "name": "FinSentinel API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "analyst",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "analyst123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "fraud_analyst"
      ]
    }
  ]
}
